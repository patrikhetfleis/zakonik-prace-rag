# Used for embeddings during ingest.py (OpenAI text-embedding-3-small)
OPENAI_API_KEY=

# Used for the chat model in app/main.py (Claude)
ANTHROPIC_API_KEY=

# Which LLM answers the questions: "anthropic" (default) or "openai"
LLM_PROVIDER=anthropic
